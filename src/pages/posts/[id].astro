---
import { getCollection, render } from "astro:content";
import "../../styles/global.css";
import MDXHeading from "../../components/MDXHeading.astro";
import MDXUl from "../../components/MDXUl.astro";
import MDXOl from "../../components/MDXOl.astro";
import MDLi from "../../components/MDXLi.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const components = {
  h2: MDXHeading,
  ul: MDXUl,
  ol: MDXOl,
  li: MDLi,
};

const currentYear = new Date().getFullYear();

// フロントマターの値を整形
const {
  title,
  pubDate,
  thumbnailUrl,
  videoUrl,
  fanzaUrl,
  categories,
} = post.data;

const formattedDate = new Date(pubDate).toLocaleDateString("ja-JP", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const isoDate = new Date(pubDate).toISOString().slice(0, 10);

// videoUrl から https:// と .com の間の文字列を抽出して大文字化
const domainMatch = videoUrl ? videoUrl.match(/https:\/\/([^\.]+)\.com/) : null;
const domainName = domainMatch ? domainMatch[1].toUpperCase() : "";
const trimmedTitle = title.length > 25 ? title.slice(0, 25) + "…" : title;
const description = `「${trimmedTitle}」の動画を無料視聴！${domainName}で長尺サンプル、FANZA TVの無料トライアルなら高画質フルを0円で視聴できます。`;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="bg-slate-950 text-slate-100 font-sans antialiased min-h-screen flex flex-col justify-between selection:bg-indigo-500 selection:text-white">
    <header class="border-b border-slate-800/80 bg-slate-950/80 backdrop-blur-md">
      <div class="max-w-4xl mx-auto px-6 py-2 flex items-center justify-center md:justify-start">
        <a href="/" aria-label="メルシー艶ログ トップページへ" class="transition-opacity hover:opacity-80">
          <img src="/logo-text.svg" alt="メルシー艶ログ" class="h-12 w-auto block md:hidden" />
          <img src="/logo.svg" alt="メルシー艶ログ" class="h-16 w-auto hidden md:block" />
        </a>
      </div>
    </header>

    <!-- Marquee Hero -->
    <div class="border-b border-slate-800/80 bg-linear-to-b from-slate-900/50 to-slate-950">
      <div class="max-w-3xl mx-auto px-6 py-6 md:py-16 space-y-6">
        <div class="inline-flex items-center gap-2 font-mono text-xs text-indigo-400 tracking-wider uppercase bg-indigo-500/10 px-3 py-1 rounded-full border border-indigo-500/20">
          <span class="w-2 h-2 rounded-full bg-indigo-400 animate-pulse shadow-[0_0_10px_rgba(129,140,248,0.5)]" aria-hidden="true"></span>
          <span>POST · {isoDate}</span>
        </div>
        <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-white leading-tight">{title}</h1>
        <div class="flex flex-wrap items-center gap-2 text-sm text-slate-400 font-mono">
          {categories && categories.map((category) => (
            <span class="text-indigo-300 bg-indigo-950/60 px-2.5 py-0.5 rounded border border-indigo-800/50">{category}</span>
          ))}
        </div>
        {description && <p class="text-lg text-slate-300 leading-relaxed max-w-2xl">{description}</p>}
      </div>
    </div>

    <main class="flex-1">
      <article class="max-w-3xl mx-auto px-6 py-12 space-y-16">
      <!-- Thumbnail -->
      <a href={videoUrl} class="block relative group overflow-hidden rounded-2xl border border-slate-800 bg-slate-900 aspect-video shadow-2xl transition-all duration-300 hover:border-indigo-500/50 hover:shadow-indigo-500/10" aria-label="サンプル動画を視聴する">
        <img
          src={thumbnailUrl}
          alt={title}
          class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          loading="eager"
          fetchpriority="high"
        />
        <div class="absolute inset-0 bg-slate-950/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col items-center justify-center gap-3 text-white backdrop-blur-[2px]">
          <span class="text-5xl text-indigo-400 drop-shadow-[0_0_15px_rgba(129,140,248,0.5)]">▶</span>
          <span class="font-mono text-sm tracking-wider uppercase font-semibold">{domainName ? `${domainName}でサンプルを視聴` : "サンプルを視聴"}</span>
        </div>
      </a>

      <!-- CTA Block -->
      <div class="bg-linear-to-br from-slate-900 to-slate-900/60 border border-slate-800/80 rounded-2xl p-8 space-y-6 shadow-xl relative overflow-hidden">
        <div class="absolute top-0 right-0 w-32 h-32 bg-indigo-500/5 rounded-full blur-3xl pointer-events-none"></div>
        <div class="space-y-2">
          <p class="text-slate-200">
            <strong class="text-white font-semibold">【いますぐ無料で見たい方へ】</strong><br />
            クリックですぐにサンプルを視聴できます。
          </p>
          <a href={videoUrl} class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 font-mono text-sm font-medium text-slate-900 bg-indigo-400 hover:bg-indigo-300 rounded-xl transition-all shadow-lg shadow-indigo-500/20 hover:shadow-indigo-500/30">{domainName ? `${domainName}でサンプル試聴` : "サンプルを視聴する"} →</a>
        </div>

        <div class="border-t border-slate-800/80 pt-6 space-y-2">
          <p class="text-slate-200">
            <strong class="text-white font-semibold">【高画質フル本編を視聴したい方へ】</strong><br />
            FANZA TVの14日間無料トライアルで0円視聴。
          </p>
          <a href={fanzaUrl} class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 font-mono text-sm font-medium text-white bg-slate-800 hover:bg-slate-700 rounded-xl border border-slate-700 transition-all">FANZA TVで無料体験する →</a>
        </div>
      </div>

      <!-- 作品概要 -->
      <section class="space-y-6">
        <h2 class="text-2xl font-bold tracking-tight text-white flex items-center gap-3">
          <span class="w-1.5 h-6 bg-indigo-500 rounded-full"></span>作品概要
        </h2>
        <ul class="bg-slate-900/40 border border-slate-800/60 rounded-2xl p-8 space-y-4 text-slate-300">
          <li class="flex flex-col sm:flex-row sm:gap-4 py-2 border-b border-slate-800/60 gap-1">
            <strong class="text-slate-400 font-mono text-sm sm:w-32 sm:shrink-0">タイトル</strong>
            <span class="text-white font-medium">{title}</span>
          </li>
          <li class="flex flex-col sm:flex-row sm:gap-4 py-2 border-b border-slate-800/60 gap-1">
            <strong class="text-slate-400 font-mono text-sm sm:w-32 sm:shrink-0">配信日</strong>
            <span class="text-white font-medium">{formattedDate}</span>
          </li>
          <li class="flex flex-col sm:flex-row sm:gap-4 py-2 border-b border-slate-800/60 gap-1">
            <strong class="text-slate-400 font-mono text-sm sm:w-32 sm:shrink-0">視聴方法</strong>
            <span class="text-white font-medium">{domainName ? `${domainName}（クリックで視聴）` : "動画サイト（クリックで視聴）"}/ FANZA TV（14日間無料トライアル）</span>
          </li>
          <li class="flex flex-col sm:flex-row sm:gap-4 py-2 gap-1">
            <strong class="text-slate-400 font-mono text-sm sm:w-32 sm:shrink-0">無料サンプル</strong>
            <span><a href={videoUrl} class="text-indigo-400 hover:underline">{domainName ? `${domainName}でサンプルを視聴` : "動画サイトのサンプルギャラリーで見る"}</a></span>
          </li>
        </ul>
      </section>

      <!-- ★ ここに MDX 本文（見どころセクション）を差し込む -->
      <section class="text-slate-300 space-y-6 leading-relaxed">
        <Content components={components} />
      </section>

      <!-- 視聴方法比較 -->
      <section class="space-y-6">
        <h2 class="text-2xl font-bold tracking-tight text-white flex items-center gap-3">
          <span class="w-1.5 h-6 bg-indigo-500 rounded-full"></span>2つの視聴方法を比较
        </h2>
        <div class="overflow-x-auto rounded-2xl border border-slate-800">
          <table class="w-full text-left text-sm text-slate-300">
            <thead class="bg-slate-900 text-xs uppercase font-mono text-slate-400 border-b border-slate-800">
              <tr>
                <th class="px-6 py-4">項目</th>
                <th class="px-6 py-4">{domainName ? `${domainName}（クリックで視聴）` : "動画サイト（クリックで視聴）"}</th>
                <th class="px-6 py-4">FANZA TV（高画質フル本編）</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-800/60 bg-slate-950/40">
              <tr class="hover:bg-slate-900/40 transition-colors">
                <th class="px-6 py-4 font-mono text-xs text-slate-400">登録</th>
                <td class="px-6 py-4"><strong class="text-white">不要</strong></td>
                <td class="px-6 py-4">必要（<strong class="text-indigo-400">14日無料</strong>）</td>
              </tr>
              <tr class="hover:bg-slate-900/40 transition-colors">
                <th class="px-6 py-4 font-mono text-xs text-slate-400">視聴開始</th>
                <td class="px-6 py-4">クリックで即再生</td>
                <td class="px-6 py-4">登録後すぐに再生可能</td>
              </tr>
              <tr class="hover:bg-slate-900/40 transition-colors">
                <th class="px-6 py-4 font-mono text-xs text-slate-400">視聴内容</th>
                <td class="px-6 py-4">サンプル・ダイジェスト</td>
                <td class="px-6 py-4"><strong class="text-white">フル本編</strong></td>
              </tr>
              <tr class="hover:bg-slate-900/40 transition-colors">
                <th class="px-6 py-4 font-mono text-xs text-slate-400">画質</th>
                <td class="px-6 py-4">標準</td>
                <td class="px-6 py-4"><strong class="text-white">高画質</strong></td>
              </tr>
              <tr class="hover:bg-slate-900/40 transition-colors">
                <th class="px-6 py-4 font-mono text-xs text-slate-400">こんな人向き</th>
                <td class="px-6 py-4">まず雰囲気だけ見たい</td>
                <td class="px-6 py-4">全部しっかり観たい</td>
              </tr>
            </tbody>
          </table>
        </div>
        <div class="flex flex-wrap items-center gap-4 pt-2">
          <a href={videoUrl} class="inline-flex items-center gap-2 px-5 py-2.5 font-mono text-sm text-indigo-400 border border-indigo-500/40 rounded-xl hover:bg-indigo-500/10 transition-all"><span>{domainName ? `${domainName}でサンプル試聴` : "動画サイトでいますぐ視聴する"} →</span></a>
          <span class="text-slate-600 font-mono">/</span>
          <a href={fanzaUrl} class="inline-flex items-center gap-2 px-5 py-2.5 font-mono text-sm text-indigo-400 border border-indigo-500/40 rounded-xl hover:bg-indigo-500/10 transition-all"><span>FANZA TVで14日間無料体験する →</span></a>
        </div>
      </section>

      <!-- 動画サイトの詳細 -->
      <section class="space-y-6">
        <h2 class="text-2xl font-bold tracking-tight text-white flex items-center gap-3">
          <span class="w-1.5 h-6 bg-indigo-500 rounded-full"></span>いますぐ視聴したい方は「{domainName ? domainName : "動画サイト"}」
        </h2>
        <p class="text-slate-300 leading-relaxed">
          <strong class="text-white">クリックだけですぐに視聴開始</strong>。登録も個人情報入力も不要です。
        </p>
        <h3 class="text-xl font-semibold text-white pt-2">{domainName ? `${domainName}の特徴` : "動画サイトの特徴"}</h3>
        <ul class="space-y-3 text-slate-300 list-disc list-inside">
          <li class="leading-relaxed">
            <strong class="text-white font-medium">登録不要・1クリック再生</strong>: サイトを開いてサムネイルをクリックするだけのシンプル操作
          </li>
          <li class="leading-relaxed">
            <strong class="text-white font-medium">ダイジェストで内容確認</strong>: 本編購入前にまず雰囲気を確かめたい方に最適
          </li>
          <li class="leading-relaxed"><strong class="text-white font-medium">完全無料</strong>: ギャラリーでのサンプル視聴は0円</li>
        </ul>
        <div class="pt-4">
          <a href={videoUrl} class="inline-flex items-center gap-2 px-5 py-2.5 font-mono text-sm text-indigo-400 border border-indigo-500/40 rounded-xl hover:bg-indigo-500/10 transition-all"><span>{domainName ? `${domainName}でサンプルを視聴する` : "動画サイトでサンプルを視聴する"} →</span></a>
        </div>
      </section>

      <!-- FANZA TV詳細 -->
      <section class="space-y-6">
        <h2 class="text-2xl font-bold tracking-tight text-white flex items-center gap-3">
          <span class="w-1.5 h-6 bg-indigo-500 rounded-full"></span>高画質フル本編を視聴したい方は「FANZA TV」
        </h2>
        <p class="text-slate-300 leading-relaxed">
          FANZA TVは、<strong class="text-white">14日間の無料トライアル</strong>を提供中。トライアル期間内なら<strong class="text-indigo-400">完全0円</strong>でフル本編を視聴できます。
        </p>

        <h3 class="text-xl font-semibold text-white pt-2">FANZA TV 無料体験の3つのメリット</h3>
        <ol class="space-y-3 text-slate-300 list-decimal list-inside">
          <li class="leading-relaxed">
            <strong class="text-white font-medium">14日間完全無料</strong>: トライアル期間中に解約すれば、<strong class="text-indigo-400">料金は一切発生しません（0円）</strong>
          </li>
          <li class="leading-relaxed">
            <strong class="text-white font-medium">フル本編・高画質</strong>: サンプルではなく、作品を最初から最後まで視聴可能
          </li>
          <li class="leading-relaxed">
            <strong class="text-white font-medium">登録は最短1〜2分</strong>: スマホ・PCどちらからでもすぐ登録して再生できます
          </li>
        </ol>

        <h3 class="text-xl font-semibold text-white pt-2">14日後どうなるの？自動継続について</h3>
        <p class="text-slate-300 leading-relaxed">
          14日間の無料トライアルが終了すると、<strong class="text-white">自動的に有料プラン（月額）へ移行</strong>します。ただし、<strong class="text-indigo-400">14日以内に解約すれば0円</strong>です。<strong class="text-white">クレジットカードへの請求は一切発生しません。</strong>
        </p>

        <h3 class="text-xl font-semibold text-white pt-2">解約し忘れが心配な方へ</h3>
        <ul class="space-y-3 text-slate-300 list-disc list-inside">
          <li class="leading-relaxed">解約は <strong class="text-white font-medium">マイページから24時間いつでも可能</strong> です</li>
          <li class="leading-relaxed"><strong class="text-indigo-400 font-medium">14日以内に解約すれば0円</strong>。難しい操作はありません</li>
          <li class="leading-relaxed">
            具体的な手順は
            <a href="/posts/dmm-cancel-guide/" class="text-indigo-400 hover:underline font-medium"
              >FANZA TVの解約ガイド（別記事）</a
            > で解説しています
          </li>
        </ul>

        <h3 class="text-xl font-semibold text-white pt-2">登録3ステップ</h3>
        <ol class="space-y-3 text-slate-300 list-decimal list-inside">
          <li class="leading-relaxed"><a href={fanzaUrl} class="text-indigo-400 hover:underline font-medium">FANZA TV公式ページ</a> にアクセス</li>
          <li class="leading-relaxed">
            「14日間無料体験を始める」から会員登録（決済情報登録が必要ですが、14日以内なら0円）
          </li>
          <li class="leading-relaxed">登録完了後、いますぐ本作のフル本編を再生！</li>
        </ol>

        <div class="pt-4">
          <a href={fanzaUrl} class="inline-flex items-center gap-2 px-5 py-2.5 font-mono text-sm text-indigo-400 border border-indigo-500/40 rounded-xl hover:bg-indigo-500/10 transition-all"><span>FANZA TVで14日間無料体験する →</span></a>
        </div>
      </section>

      <!-- FAQ -->
      <section class="space-y-6">
        <h2 class="text-2xl font-bold tracking-tight text-white flex items-center gap-3">
          <span class="w-1.5 h-6 bg-indigo-500 rounded-full"></span>よくある質問
        </h2>

        <div class="bg-slate-900/40 border border-slate-800/60 rounded-2xl p-6 space-y-2">
          <p class="font-semibold text-white">Q. 本当に完全無料ですか？</p>
          <p class="text-slate-300 leading-relaxed">
            <strong class="text-indigo-400">A. はい、14日以内に解約すれば0円</strong>です。FANZA TVは14日間の無料トライアルを提供しており、期間内に解約手続きを行えば、<strong class="text-white">クレジットカードへの請求は一切発生しません</strong>。
          </p>
        </div>

        <div class="bg-slate-900/40 border border-slate-800/60 rounded-2xl p-6 space-y-2">
          <p class="font-semibold text-white">Q. 14日後はどうなりますか？</p>
          <p class="text-slate-300 leading-relaxed">
            <strong class="text-indigo-400">A. 自動的に有料プラン（月額）に移行</strong>します。<strong class="text-indigo-400">14日以内に解約すれば0円</strong>なので、無料で楽しみたい方は期間内の解約をお忘れなく。
          </p>
        </div>

        <div class="bg-slate-900/40 border border-slate-800/60 rounded-2xl p-6 space-y-2">
          <p class="font-semibold text-white">Q. 解約はいつでもできますか？</p>
          <p class="text-slate-300 leading-relaxed">
            <strong class="text-indigo-400">A. はい、14日トライアル中であっても、24時間いつでも解約可能</strong>です。マイページから数クリックで手続きできます。詳細は
            <a href="/posts/dmm-cancel-guide/" class="text-indigo-400 hover:underline">解約ガイド</a> をご覧ください。
          </p>
        </div>

        <div class="bg-slate-900/40 border border-slate-800/60 rounded-2xl p-6 space-y-2">
          <p class="font-semibold text-white">Q. 解約し忘れたらどうなりますか？</p>
          <p class="text-slate-300 leading-relaxed">
            <strong class="text-amber-400">A. 月額料金が請求されます</strong>。<strong class="text-indigo-400">14日以内に解約すれば0円</strong>なので、登録後すぐにカレンダーにリマインダーを設定しておくのがおすすめです。
          </p>
        </div>

        <div class="bg-slate-900/40 border border-slate-800/60 rounded-2xl p-6 space-y-2">
          <p class="font-semibold text-white">Q. 登録に必要なものは？</p>
          <p class="text-slate-300 leading-relaxed">
            <strong class="text-white">A. メールアドレスとクレジットカード</strong>（またはその他の決済方法）です。決済情報が必要なのは、<strong class="text-white">14日後に自動継続される仕様のため</strong>。トライアル期間中の課金はされません。
          </p>
        </div>
      </section>

      <!-- まとめ -->
      <section class="space-y-6">
        <h2 class="text-2xl font-bold tracking-tight text-white flex items-center gap-3">
          <span class="w-1.5 h-6 bg-indigo-500 rounded-full"></span>まとめ
        </h2>
        <p class="text-slate-300 leading-relaxed">本作を楽しむには2つの方法があります：</p>
        <ul class="space-y-3 text-slate-300 list-disc list-inside">
          <li class="leading-relaxed">
            <strong class="text-white">いますぐ無料で見たい</strong> →
            <a href={videoUrl} class="text-indigo-400 hover:underline">{domainName ? domainName : "動画サイト"}</a> でクリック視聴
          </li>
          <li class="leading-relaxed">
            <strong class="text-white">高画質フル本編を視聴したい</strong> →
            <a href={fanzaUrl} class="text-indigo-400 hover:underline">FANZA TV</a> で14日間無料トライアル
          </li>
        </ul>
        <p class="text-slate-300 leading-relaxed">
          <strong class="text-indigo-400">FANZA TVは14日以内に解約すれば0円</strong>。まずは気になる方法で本作をチェックしてみてください。
        </p>

        <div class="pt-4 flex flex-col sm:flex-row gap-4">
          <a href={videoUrl} class="inline-flex items-center justify-center px-6 py-3 font-mono text-sm font-medium text-slate-900 bg-indigo-400 hover:bg-indigo-300 rounded-xl transition-all shadow-lg shadow-indigo-500/20">{domainName ? `${domainName}でサンプルを視聴する` : "動画サイトでサンプルを視聴する"} →</a>
          <a href={fanzaUrl} class="inline-flex items-center justify-center px-6 py-3 font-mono text-sm font-medium text-white bg-slate-800 hover:bg-slate-700 rounded-xl border border-slate-700 transition-all">FANZA TVで14日間無料体験する →</a>
        </div>
      </section>

      <p class="text-xs text-slate-500 leading-relaxed pt-4 border-t border-slate-900">
        ※ 本ページの記載は2026年9月時点の調査に基づきます。FANZA TV の利用規約・料金・特典内容は変更される場合があります。最新情報は各公式サイトでご確認ください。
      </p>
    </article>
